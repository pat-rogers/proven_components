--  This project file is for clients of the Proven Components library, that is,
--  when using one or more of the components in client code.

--  with "sparklib";     removed until sparklib 16 can be used (when cross-compilers at 16 are available)

with "config/proven_components_config.gpr";

project Proven_Components is

   Profile : Proven_Components_Config.Profile_Kind := Proven_Components_Config.Profile;

   case Profile is
      when "Full" =>
         for Source_Dirs use ("src/**");
      when "Embedded" =>  --  no concurrency/ for sake of Ravenscar/Jorvik Profile subset violations
         for Source_Dirs use ("src/containers",
                              "src/control_systems",
                              "src/images",
                              "src/misc",
                              "src/networking",
                              "src/numerics",
                              "src/proof_utils",
                              "src/random_numbers",
                              "src/signal_processing",
                              "src/sorting_searching",
                              "src/sparklib");
      when "Light" =>  --  Embedded, less what a runtime below "embedded" cannot supply
         for Source_Dirs use ("src/containers",
                              "src/control_systems",
                              "src/images",
                              "src/misc",
                              "src/networking",
                              "src/numerics",
                              "src/proof_utils",
                              "src/signal_processing",
                              "src/sorting_searching");

         --  Five of those directories are mixed: each holds units that a light runtime
         --  compiles and units that need the embedded one. Omitting a whole directory
         --  instead would remove units that a light runtime does compile, and prove
         --  where they are in SPARK, so the rest are excluded individually below.
         --  Math_Utilities is not optional here: Recursive_Moving_Average_Filters uses it.
         for Excluded_Source_Files use
           ("kalman_filters_linear.ads", "kalman_filters_linear.adb",  -- Ada.Numerics.Generic_Real_Arrays
            "time_stamps.ads",           "time_stamps.adb",            -- Ada.Calendar
            "permutation_utils.ads",     "permutation_utils.adb",      -- SPARKlib, so Ada.Containers
            "sorting_proof_utils.ads",   "sorting_proof_utils.adb",    -- SPARKlib, so Ada.Containers
            "sort_routines.ads",         "sort_routines.adb");         -- SPARKlib, so Ada.Containers
   end case;

   for Object_Dir use "obj/" & Profile;

   package Compiler is
      --  Note that "-gnata" is NOT included. Use the pragma Assertion_Policy on the
      --  generic instantiations to control the code generated for these checks.
      for Default_Switches ("Ada") use (
         "-gnatwa",    -- enable additional warnings
         "-gnatwe",    -- treat warnings as errors
         "-gnatwJ",    -- DON'T COMPLAIN ABOUT PARENS IN AGGREGATES!
         "-gnatf",     -- full errors
         "-O2",        -- "full" optimization (-O3 is "aggressive" optimization)
         "-gnatn",     -- enable inlining across units
         "-ffunction-sections",
         "-fdata-sections",
         "-gnat2022"); -- required for compatibility with sparklib anyway
   end Compiler;

   package Pretty_Printer is
      for Switches ("Ada") use ("-nM", "--no-separate-loop-then", "-M120");
   end Pretty_Printer;

   package Clean is
      --  Enumerated rather than "*.*": with some gprclean versions the root
      --  project's pattern is applied to imported projects, and "*.*" then
      --  deletes the Alire-generated config projects.
      for Artifacts_In_Object_Dir use ("*.o", "*.ali", "*.json", "*.elf", "*.bin", "*.map", "map.txt");
   end Clean;

end Proven_Components;

